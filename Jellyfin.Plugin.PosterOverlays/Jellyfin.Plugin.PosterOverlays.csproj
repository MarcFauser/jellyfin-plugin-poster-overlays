<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 is not a preference but a constraint: Jellyfin 10.11 runs on the .NET 9
         runtime and cannot load a net10.0 assembly. net10.0 targets the v12 line. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.PosterOverlays</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reproducible artifacts. Without these two, every commit produces a different DLL -
         including commits that only touch the README - which silently invalidates the
         checksum of an already published release. Two separate channels: the SDK appends
         the HEAD commit to AssemblyInformationalVersion, and SourceLink writes a commit
         map into the PDB whose checksum the assembly carries. Turning off the SCM queries
         kills both. Taken over from Jellyfin.Plugin.JFLint, where it was measured. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- PathMap rewrites the build directory to a fixed placeholder so a clone at any
         other path produces the same bytes. ContinuousIntegrationBuild does not achieve
         this here because it normalises via SourceRoot, which the SCM queries supply. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- Jellyfin's own ruleset, taken verbatim from jellyfin-plugin-template. It turns off
         the StyleCop rules that contradict Jellyfin's house style (usings outside the
         namespace, no file headers, no 'this.' prefix) and sharpens six CA rules to Error.
         Everything not listed there still fails the build. -->
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)..\jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- The major version encodes the Jellyfin line this build belongs to: 11.x for
       Jellyfin 10.11, 12.x for Jellyfin 12. No version number may appear twice in the
       repository manifest, and a server upgrading from 10.11 to 12 must see the v12 build
       as the higher version, otherwise it silently keeps running the net9.0 assembly. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Version>11.24.0.0</Version>
    <AssemblyVersion>11.24.0.0</AssemblyVersion>
    <FileVersion>11.24.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Version>12.24.0.0</Version>
    <AssemblyVersion>12.24.0.0</AssemblyVersion>
    <FileVersion>12.24.0.0</FileVersion>
  </PropertyGroup>

  <!-- ControllerBase, [ApiController], [Authorize]. The server hosts ASP.NET Core; the plugin
       only compiles against it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ExcludeAssets="runtime": the server ships these assemblies itself, the plugin must
       not place copies next to its own DLL.

       SkiaSharp needs IncludeAssets="compile" rather than ExcludeAssets="runtime", and the
       difference was measured rather than reasoned about: with ExcludeAssets="runtime" the
       managed assembly is indeed left out, but the NATIVE assets are a separate asset group
       and travelled anyway. The packages came out at 19 MB and 86 MB, carrying
       runtimes/win-x64, win-x86, win-arm64 and osx copies of libSkiaSharp - useless on a
       Linux server, and exactly the second copy this reference is supposed to prevent.
       IncludeAssets="compile" says what is actually meant: reference it to compile, ship
       nothing. build.ps1 asserts the result on the packed ZIP as well.

       The SkiaSharp versions are the ones the server itself references, read from
       Directory.Packages.props of each branch (measured 2026-08-22). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc3" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc3" ExcludeAssets="runtime" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
  </ItemGroup>

  <!-- The typeface is embedded rather than resolved by family name. SkiaSharp asks the host's
       font configuration for a family, and a Jellyfin container may carry no fonts at all; a
       face loaded from a stream needs neither fontconfig nor a system font. Inter SemiBold was
       chosen on rendered comparisons at real card size - Regular loses stroke coverage when the
       1000px master is resampled to a 200px tile. The SIL Open Font License travels with it. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Inter-SemiBold.ttf" />
    <EmbeddedResource Include="Resources\Inter-LICENSE.txt" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.PosterOverlays.Tests" />
  </ItemGroup>

</Project>
